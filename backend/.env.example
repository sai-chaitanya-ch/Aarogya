# Backend configuration; set these in Render Environment, never in Vite variables.
FRONTEND_ORIGIN=https://aarogya-for-you.netlify.app
ADDITIONAL_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Models: Gemini primary and Groq fallback. Use real keys in Render only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GROQ_API_KEY=
# Groq fallback: supported high-capacity openai/gpt-oss-120b with low-latency openai/gpt-oss-20b backup
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

# Supabase server-only credentials. NEVER put service role key in frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

RAG_CHUNK_SIZE=1400
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.20
LOG_LEVEL=INFO
PORT=8000

# Frontend Environment Variables (Netlify & Local)
# URL of your Python FastAPI Backend running on Render (e.g. https://aarogya-staging-api.onrender.com)
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_API_URL=http://127.0.0.1:8000

# Supabase Project Configuration (Publishable/Anon key only. NEVER service role key)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key
